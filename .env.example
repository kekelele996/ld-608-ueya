# ground-turn 航空地勤周转保障平台 · 环境变量样例
# 启动命令：cp .env.example .env && docker compose up -d

# Compose 项目名（容器名前缀，避免中文目录导致的命名问题）
COMPOSE_PROJECT_NAME=ground-turn

# 前端宿主机端口（容器内固定 80）
FRONTEND_PORT=20108

# 后端宿主机端口（容器内固定 3000）
BACKEND_PORT=21108

# MySQL 宿主机映射端口（容器内固定 3306）
DB_PORT=33060

# MySQL 数据库与账号
DB_NAME=app_db
DB_USER=app_user
DB_PASSWORD=app_password

# JWT 签名密钥（生产部署请修改）
JWT_SECRET=local-dev-secret

# 启动时是否写入本地演示种子数据（true/false）
SEED_ON_START=true
